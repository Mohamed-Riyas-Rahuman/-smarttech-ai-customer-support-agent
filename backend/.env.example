APP_ENV=development
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# Security
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database seeding: required only when creating a new seed administrator.
# Set SEED_DEMO_USERS=true to create the optional demo accounts; each enabled
# account must have its own password configured. Use private values of 12+ chars.
SEED_ADMIN_PASSWORD=
SEED_DEMO_USERS=false
SEED_MANAGER_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_ANALYST_PASSWORD=

# AI / Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# RAG & Embeddings
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
RAG_PRODUCT_TOP_K=10

# Gmail Integration (Optional)
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
GMAIL_POLL_INTERVAL_SECONDS=10

# Langfuse Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Safety Controls
AUTO_SEND_ENABLED=false
CONFIDENCE_THRESHOLD=0.70

# CORS
CORS_ORIGINS=http://localhost:5173

# Local file storage
UPLOAD_DIR=data/uploads
SAMPLE_KNOWLEDGE_DIR=data/sample_knowledge_base
KNOWLEDGE_BASE_DIR=data/knowledge_base
